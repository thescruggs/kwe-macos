# SPDX-License-Identifier: Apache-2.0
post_install() {
    echo ":: The wallpaper service (kwe-daemon) runs as a per-user systemd unit"
    echo ":: and is not started automatically. Enable and start it with:"
    echo "     systemctl --user enable --now kwe-daemon.service"
}

post_upgrade() {
    post_install
}
