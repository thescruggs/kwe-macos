post_install() {
    echo ":: The wallpaper service (kwe-daemon) runs as a per-user systemd unit"
    echo ":: and is not started automatically. Enable and start it with:"
    echo "     systemctl --user enable --now kwe-daemon.service"
}

post_upgrade() {
    post_install
    echo ":: The running service keeps the OLD binary until it is restarted, and"
    echo ":: a stale daemon supervising the new renderers misreports failures"
    echo ":: (docs/bugs/APPLY_REJECTED_QUARANTINED.md). Restart it now:"
    echo "     systemctl --user daemon-reload && systemctl --user restart kwe-daemon.service"
    echo ":: Until then the manager refuses Apply with 'service_stale'."
    echo ":: If you enabled the service before this release, re-enable it once:"
    echo "     systemctl --user disable kwe-daemon.service"
    echo "     systemctl --user enable --now kwe-daemon.service"
    echo ":: The unit moved from default.target to graphical-session.target so"
    echo ":: it starts with a display in reach; the old symlink starts it too"
    echo ":: early and leaves the output picker empty."
}
