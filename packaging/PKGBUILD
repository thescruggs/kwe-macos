# Maintainer: KDE Wallpaper Engine developers
# SPDX-License-Identifier: GPL-3.0-or-later
#
# AUR package for KDE Wallpaper Engine.
#
# Source selection: when this PKGBUILD is built from inside the project
# checkout (packaging/ lives in the repository root), the source is the local
# git repository at its current committed HEAD, so `makepkg -si` needs no
# network access and never prompts for credentials. Anywhere else (AUR
# builders, CI) the published GitHub repository is used instead.
#
# Notes:
#  - Uncommitted changes in the checkout are not part of the package (a git
#    clone only sees committed state). Commit first if you want them included.
#  - The GitHub repository does not exist yet: push it before relying on the
#    AUR path, and keep the pinned commit below in sync with what is pushed.
#  - To force the GitHub source while building inside the checkout (for
#    example, to regenerate .SRCINFO for AUR submission):
#        KWE_FORCE_AUR_SOURCE=1 makepkg --printsrcinfo
#  - namcap may note the file:// branch; it is intentional for local builds.

if [[ -z "${KWE_FORCE_AUR_SOURCE:-}" && -f "../Cargo.toml" ]]; then
    _source="git+file://$(cd .. && pwd -P)#commit=$(git -C .. rev-parse --short HEAD)"
else
    _source="git+https://github.com/kde-wallpaper-engine/kde-wallpaper-engine.git#commit=4477783"
fi
source=("kde-wallpaper-engine::${_source}")
sha256sums=('SKIP')
install=kde-wallpaper-engine.install

pkgname=kde-wallpaper-engine
pkgver=0.1.0.alpha.1
pkgrel=17
pkgdesc="Experimental Plasma 6 app to browse, install, and safely run Wallpaper Engine Workshop wallpapers via a supervised renderer daemon"
arch=('x86_64')
url="https://github.com/kde-wallpaper-engine/kde-wallpaper-engine"
license=('GPL-3.0-or-later')
# Package names reflect the 2026 KDE split renames: Kirigami ships as
# `kirigami`, and Qt Quick Controls 2 is part of `qt6-declarative`.
depends=(
    'qt6-base'
    'qt6-declarative'
    'kirigami'
    'vulkan-icd-loader'
    'vulkan-driver'
    # The apply lane shells out to both of these for its read-only output
    # enumeration (crates/kwe-daemon/src/apply.rs): kscreen-doctor is
    # authoritative for which outputs exist, and qdbus6 (qt6-tools) carries
    # the Plasma shell probe and the wallpaper switch. Without them every
    # apply fails with shell_unreachable.
    'kscreen'
    'qt6-tools'
    # S2: kwe-scene-renderer dlopens libshaderc_shared.so.1 at runtime for
    # the material-shader GLSL -> SPIR-V compile (crates/kwe-scene-renderer,
    # the `shaderc` crate, default features — no vendored glslang build;
    # see THIRD_PARTY.yml's rust-shaderc entry).
    'shaderc'
)
makedepends=(
    'rust'
    'cmake'
    'ninja'
    'git'
    'qt6-base'
    'qt6-declarative'
    'kirigami'
    # S2: pkg-config discovers the system libshaderc at build time
    # (shaderc.pc); the same 'shaderc' package provides both that and the
    # runtime .so, so it is listed in both arrays.
    'shaderc'
)

build() {
    cd "${srcdir}/kde-wallpaper-engine"
    export CARGO_TARGET_DIR="${srcdir}/cargo-target"
    # CachyOS/Arch toolchain envs carry -flto=auto. The cc-built C archives
    # (bundled QuickJS, the stb_truetype shim) compile as GCC-LTO objects and
    # rust-lld cannot LTO-link them: the final link fails with undefined
    # JS_*/kwe_font_* symbols. Drop the flag for the cargo steps.
    export CFLAGS="${CFLAGS//-flto=auto/}"
    export CXXFLAGS="${CXXFLAGS//-flto=auto/}"
    export LDFLAGS="${LDFLAGS//-flto=auto/}"
    cargo build --release --workspace
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF
    cmake --build build
}

check() {
    cd "${srcdir}/kde-wallpaper-engine"
    export CARGO_TARGET_DIR="${srcdir}/cargo-target"
    export CFLAGS="${CFLAGS//-flto=auto/}"
    export CXXFLAGS="${CXXFLAGS//-flto=auto/}"
    export LDFLAGS="${LDFLAGS//-flto=auto/}"
    # kwe-vulkan exercises real Vulkan instances and is excluded so the test
    # run also works in GPU-less build environments.
    cargo test --release --workspace --exclude kwe-vulkan
}

package() {
    cd "${srcdir}/kde-wallpaper-engine"
    export CARGO_TARGET_DIR="${srcdir}/cargo-target"

    # Rust binaries. The daemon resolves its default renderer as
    # `kwe-test-renderer` next to its own executable, so both must land in
    # /usr/bin. kwe-vulkan is the original ash-based renderer; kwe is the CLI.
    install -Dm755 "${CARGO_TARGET_DIR}/release/kwe-daemon" "${pkgdir}/usr/bin/kwe-daemon"
    install -Dm755 "${CARGO_TARGET_DIR}/release/kwe-test-renderer" "${pkgdir}/usr/bin/kwe-test-renderer"
    install -Dm755 "${CARGO_TARGET_DIR}/release/kwe-vulkan" "${pkgdir}/usr/bin/kwe-vulkan"
    install -Dm755 "${CARGO_TARGET_DIR}/release/kwe" "${pkgdir}/usr/bin/kwe"
    # Beta renderer workers (packaged ahead of the release milestone so test
    # builds can drive video/web wallpapers; the daemon resolves them next to
    # its own executable).
    install -Dm755 "${CARGO_TARGET_DIR}/release/kwe-video-renderer" "${pkgdir}/usr/bin/kwe-video-renderer"
    install -Dm755 "${CARGO_TARGET_DIR}/release/kwe-web-renderer" "${pkgdir}/usr/bin/kwe-web-renderer"
    install -Dm755 "${CARGO_TARGET_DIR}/release/kwe-audio-worker" "${pkgdir}/usr/bin/kwe-audio-worker"
    install -Dm755 "${CARGO_TARGET_DIR}/release/kwe-scene-renderer" "${pkgdir}/usr/bin/kwe-scene-renderer"

    # Qt/Kirigami manager, frame preview, org.kde.kwe.display QML module, and
    # the staged org.kde.kwe.wallpaper Plasma wallpaper package.
    DESTDIR="${pkgdir}" cmake --install build

    install -Dm644 packaging/org.kde.kwe.desktop "${pkgdir}/usr/share/applications/org.kde.kwe.desktop"
    install -Dm644 packaging/systemd/kwe-daemon.service "${pkgdir}/usr/lib/systemd/user/kwe-daemon.service"
}
