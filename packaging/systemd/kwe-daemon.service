# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=KDE Wallpaper Engine user service
Documentation=man:kwe-daemon(1)
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/kwe-daemon --state-dir=${STATE_DIRECTORY}
# Restart=always, not on-failure: a clean stop at session teardown is not a
# failure, yet the desktop must not lose its wallpaper service when the next
# session starts. StartLimitBurst/IntervalSec in [Unit] bound restart loops,
# and an explicit `systemctl --user stop kwe-daemon` still wins because
# systemd does not restart a unit stopped by the administrator.
Restart=always
RestartSec=2s
RuntimeDirectory=kwe
RuntimeDirectoryMode=0700
StateDirectory=kwe
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=1024
LimitCORE=0
MemoryHigh=768M
# The daemon plus audio worker and a Chromium-based web renderer need more
# than the alpha's single test renderer budget; MemoryHigh stays as a soft
# cap so OOM policy continues to prefer killing the renderer.
MemoryMax=3G
MemorySwapMax=256M
OOMPolicy=continue
CPUQuota=400%
# Chromium spawns many helper threads/tasks; 64 was too tight for the beta.
TasksMax=96
TimeoutStopSec=5s

# Do not add PrivateDevices= or MemoryDenyWriteExecute=: Vulkan renderers need
# DRM render nodes and graphics drivers may need executable shader mappings.

[Install]
WantedBy=default.target
